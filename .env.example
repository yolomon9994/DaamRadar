DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate a unique secret for deployment.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Empty means SQLite. Example PostgreSQL URL (URL-encode special characters):
DATABASE_URL=
# DATABASE_URL=postgresql://daamradar:password@localhost:5432/daamradar
# HTTPS deployment settings; leave false for local HTTP.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
# Manual collection only. Per-retailer admin settings also have to be enabled.
SCRAPING_ENABLED=false
# Monitored email OR a public HTTPS project/contact URL, included in the User-Agent.
SCRAPER_CONTACT=
SCRAPER_DELAY_SECONDS=5
# One delayed retry for a connection/read timeout only. Set to 0 to disable.
SCRAPER_TIMEOUT_RETRIES=1
SCRAPER_RETRY_DELAY_SECONDS=10
SCRAPER_CONNECT_TIMEOUT=10
SCRAPER_READ_TIMEOUT=20
PRICE_STALE_HOURS=48
