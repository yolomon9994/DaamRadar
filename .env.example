DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate a unique secret for deployment.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Empty means SQLite. Example PostgreSQL URL (URL-encode special characters):
DATABASE_URL=
# DATABASE_URL=postgresql://daamradar:password@localhost:5432/daamradar
# HTTPS deployment settings; leave false for local HTTP.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
# Collection stays disabled until terms, robots, and source behavior are validated.
SCRAPING_ENABLED=false
SCRAPER_CONTACT=
SCRAPER_DELAY_SECONDS=5
PRICE_STALE_HOURS=48
