# Deploy in a separate checkout or set these through your hosting environment.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=false
# Generate a unique value; never use the CI key in production.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=daamradar.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://daamradar.example
DATABASE_URL=postgresql://daamradar:REPLACE_PASSWORD@127.0.0.1:5432/daamradar
DJANGO_STATIC_ROOT=staticfiles
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
# Enable HSTS only after HTTPS and the domain's subdomain policy are verified.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# Optional: exact reverse-proxy peer IP; leave empty if headers are not trusted.
WAITRESS_TRUSTED_PROXY=
PORT=8080
SCRAPING_ENABLED=false
SCRAPER_CONTACT=
